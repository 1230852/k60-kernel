# ============================================================================
#  日常可用性基线：关闭 GKI 调试特性
#
#  事实依据：arch/arm64/configs/gki_defconfig 里带着调试构建才用的选项
#      CONFIG_KASAN=y
#      CONFIG_KASAN_HW_TAGS=y
#      CONFIG_KFENCE=y
#      CONFIG_UBSAN=y
#      CONFIG_UBSAN_TRAP=y
#      CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off ..."
#
#  为什么必须关：
#   1. UBSAN_TRAP=y 会把"未定义行为"从打印警告变成 **直接 panic**。
#      内核里 UB 触发点不少，日常使用会出现莫名其妙的随机重启。
#   2. KASAN 为每次内存访问加影子内存检查，CPU 与内存开销极大，
#      而且与 arm64 的 entry 汇编存在冲突（CI 实测会在 kernel_entry 宏上
#      报 "attempt to move .org backwards" / "bad or irreducible absolute
#      expression" 而中断编译）。
#   3. KFENCE 是采样式内存错误检测，同样只应用于调试。
#
#  安全性说明：这些都不影响 KMI / vermagic / 模块 CRC，
#  关闭后厂商预编译模块照常加载，只是不再做调试性检查。
# ============================================================================

# ---- KASAN ----
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_SW_TAGS is not set
# CONFIG_KASAN_INLINE is not set
# CONFIG_KASAN_OUTLINE is not set
# CONFIG_KASAN_STACK is not set
# CONFIG_KASAN_VMALLOC is not set

# ---- KFENCE ----
# CONFIG_KFENCE is not set

# ---- UBSAN（尤其 UBSAN_TRAP，会把警告升级成 panic）----
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_UBSAN_LOCAL_BOUNDS is not set
# CONFIG_UBSAN_BOUNDS is not set
# CONFIG_UBSAN_ALIGNMENT is not set

# ---- 其它调试开销 ----
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_SLUB_DEBUG_ON is not set
# CONFIG_PAGE_POISONING is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_FAILSLAB is not set
# CONFIG_FAULT_INJECTION is not set

# ---- 小米未发布源码的驱动：关闭其内核内建消费者 ----
# drivers/misc/gpio-testing-mode.c 是 =y(内建)，它 #include "hwid.h" 并调用
# get_hw_country_version() / CountryCN —— 这些符号定义在小米**未发布**的
# drivers/misc/hwid 驱动里，因此内建编译必然报 implicit declaration 而中断。
#
# 关键事实：hwid.ko 出现在 modules.list.msm.mondrian 中，说明它是手机
# vendor_dlkm 分区里的预编译模块，由它导出该符号给 cnss2.ko(WiFi) 使用。
# 我们不动 vendor_dlkm，所以 WiFi 不受影响，内核里不需要这个符号。
#
# gpio-testing-mode 是小米工厂 GPIO 测试驱动，日常使用无作用，关掉即可。
# CONFIG_GPIO_TESTING_MODE is not set
