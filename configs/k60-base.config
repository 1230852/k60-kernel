# ============================================================================
#  设备基线覆盖 —— 极度克制版
#
#  【重要教训 / 为什么这个文件被重写过】
#
#  旧版本这个文件关掉了十几个开关, 包括:
#      # CONFIG_KASAN is not set
#      # CONFIG_KASAN_HW_TAGS is not set
#      # CONFIG_KFENCE is not set
#      # CONFIG_UBSAN is not set   /  UBSAN_TRAP / UBSAN_BOUNDS / ...
#      # CONFIG_PAGE_OWNER is not set
#      # CONFIG_SLUB_DEBUG_ON is not set
#      # CONFIG_DEBUG_KMEMLEAK is not set
#      ...
#  理由是"日常可用性"(UBSAN_TRAP 会把 UB 升级成 panic)和"编译冲突"。
#
#  但从用户原机 boot.img 里提取出小米真实的 .config 后发现:
#      *** 小米的量产内核这些开关全都是打开的 ***
#          CONFIG_KASAN=y            CONFIG_KASAN_HW_TAGS=y
#          CONFIG_KFENCE=y           CONFIG_UBSAN=y  CONFIG_UBSAN_TRAP=y
#          CONFIG_PAGE_OWNER=y       CONFIG_SLUB_DEBUG=y
#          CONFIG_DEBUG_INFO=y       CONFIG_CFI_CLANG_SHADOW=y   ...
#
#  ROM 里的闭源 vendor 模块 (触控/指纹/WiFi/显示/音频) 是小米用**他们那份
#  配置**编出来的。我们单方面关掉这些开关, 等于让内核与模块的构建配置不一致 ——
#  这正是四次构建全部"logo 一闪就重启"的高度嫌疑原因。
#
#  所以本文件现在只保留**有硬性理由**的覆盖, 其余一律照抄原机配置。
# ============================================================================

# ---- 1) 关掉原机配置里指向小米编译机路径的项 (否则编译直接失败) ----
# 原机: CONFIG_TRIM_UNUSED_KSYMS=y
#       CONFIG_UNUSED_KSYMS_WHITELIST="/mnt/disks/build-disk/src/android/common-android12-5.10-2023-11/out/.../abi_symbollist.raw"
# 那个白名单文件只在小米的构建机上存在, 缺失会导致:
#   ERROR: '...abi_symbollist.raw' whitelist file not found
#   make[1]: *** [Makefile:1423: include/generated/autoksyms.h] Error 1
# 关掉后我们导出的符号只会比原机更多(超集), 对 vendor 模块只会更友好。
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_UNUSED_KSYMS_WHITELIST=""

# ---- 2) 关掉小米未开源驱动导致的内建编译失败 (官方树特有) ----
# drivers/misc/gpio-testing-mode.c 是 =y(内建), 它 #include "hwid.h" 并调用
# get_hw_country_version() / CountryCN —— 这些符号定义在小米**未发布**的
# drivers/misc/hwid 驱动里, 内建编译必然报 implicit declaration 而中断。
# hwid.ko 在 modules.list.msm.mondrian 里, 说明它是 vendor_dlkm 的预编译模块,
# 我们不动 vendor_dlkm, 所以 WiFi 不受影响。
# CONFIG_GPIO_TESTING_MODE is not set

# ---- 3) 关掉调试信息 (只影响构建耗时与磁盘, 不参与 Image, 不影响 ABI) ----
# 原机开着 CONFIG_DEBUG_INFO=y, 但它不进 Image(debug 段不被 objcopy 带走),
# 不影响 vermagic / 符号 CRC / 模块加载, 关掉纯粹为了省 CI 时间和磁盘。
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set

# ============================================================================
#  以下全部**保持原机配置的值**, 不再单方面关闭 —— 这是本次的核心修改:
#      CONFIG_KASAN=y            CONFIG_KASAN_HW_TAGS=y
#      CONFIG_KFENCE=y           CONFIG_UBSAN=y  CONFIG_UBSAN_TRAP=y
#      CONFIG_UBSAN_BOUNDS=y     CONFIG_UBSAN_LOCAL_BOUNDS=y
#      CONFIG_PAGE_OWNER=y       CONFIG_PAGE_PINNER=y
#      CONFIG_SLUB_DEBUG=y       CONFIG_DEBUG_MEMORY_INIT=y
#      CONFIG_DEBUG_KMEMLEAK / FAILSLAB / FAULT_INJECTION / DEBUG_PAGEALLOC
#  如果编译阶段因为这些项报错(旧脚本曾记录 KASAN 与 arm64 entry 汇编冲突),
#  构建日志会直接指出是哪个文件哪一行, 再针对性处理 —— 而不是整体关掉。
# ============================================================================

# ---- 4) 关掉 WERROR (只影响"警告是否中断编译", 与内核行为/ABI 完全无关) ----
# 原机配置: CONFIG_WERROR=y + CONFIG_FRAME_WARN=2048
# 于是任何栈帧超过 2048 字节的函数都会变成**编译错误**。KASAN 会显著放大栈帧,
# 实测(CI run #10)一次就报了 39 个:
#   ../fs/quota/quota.c:900:1: error: stack frame size of 3424 bytes in
#        function '__arm64_sys_quotactl' [-Werror,-Wframe-larger-than=]
#   ../io_uring/io_uring.c:6765:12: error: stack frame size of 2496 bytes ...
#   ../net/ethtool/ioctl.c:2722:5: error: stack frame size of 2976 bytes ...
# 小米能用他们的 clang 过这套检查, 我们这份 5.10.270 代码过不去。
#
# 关掉 WERROR 后这些只是警告, 编译继续。
# 安全性: CONFIG_WERROR 不参与 Image, 不影响 vermagic / 符号 CRC / 模块加载 /
#        运行时行为, 纯构建期开关。
# CONFIG_WERROR is not set
CONFIG_FRAME_WARN=0

# ---- 5) 【关键修正】KASAN 必须用硬件模式 (HW_TAGS), 不能退化成通用软件 KASAN ----
# 实测依据 (CI run #12 的构建日志):
#   原机 / 参考可开机内核:  CONFIG_KASAN=y   CONFIG_KASAN_HW_TAGS=y
#                           # CONFIG_KASAN_GENERIC is not set
#   我们 run #12 编出来:    CONFIG_KASAN_HW_TAGS <未设置>  ->  退化成 KASAN_GENERIC
#
# 基线配置 (k60-stock-baseline.config) 本来是带 HW_TAGS 的, 但 olddefconfig 把它
# 丢掉了 —— KASAN 模式是个 choice, 默认项是 KASAN_GENERIC, 一旦 HW_TAGS 的依赖
# 没被满足就会静默回落到默认值。
#
# 软件 KASAN 会为内核预留 1/8 地址空间的影子内存, 大幅改变最早期内存布局,
# 这正是"开机第一屏就重启"这类早期崩溃的高度嫌疑原因。所以这里显式钉死,
# 并在 configure.sh 的配置闸门里加硬断言 —— 再被丢掉就直接失败, 不浪费一次编译。
CONFIG_KASAN=y
CONFIG_ARM64_MTE=y
CONFIG_KASAN_HW_TAGS=y
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_SW_TAGS is not set

# ---- 6) 内核版本串 ----
# 目标: 5.10.270-android12-miwu-sukisu+bbg守护
#
# 【为什么这里留空】
# 版本串 = VERSION.PATCHLEVEL.SUBLEVEL + $(setlocalversion 的输出), 而
# scripts/setlocalversion:200 是
#     res="${res}${CONFIG_LOCALVERSION}${LOCALVERSION}"
# 它要先去 source include/config/auto.conf 才能拿到 CONFIG_LOCALVERSION。
# 实测(CI run #15): auto.conf 在某些时序下是旧的 —— .config 里
# CONFIG_LOCALVERSION_AUTO 明明已经关掉, setlocalversion 却读到了 =y,
# 于是输出了 SCM 串 '-g242b97810776' 而不是我们的名字。
#
# 所以改成"构造上不可能错"的做法: configure.sh 把 scripts/setlocalversion
# 换成一个只 echo 固定后缀的脚本, CONFIG_LOCALVERSION 留空 ——
# 最终串不再依赖 git 状态 / LOCALVERSION_AUTO / auto.conf 新鲜度。
# build.sh 里还有一道硬校验: 名字不对就构建失败, 绝不交付。
CONFIG_LOCALVERSION=""

# 【重要】LOCALVERSION_AUTO 按原机保持 =y。
# 上面已经把 scripts/setlocalversion 整个换成了固定输出, 它压根不看这个开关,
# 所以版本串照样是精确的 5.10.270-android12-miwu-sukisu+bbg守护。
# 之前把它关掉是多余的, 而且造成了连锁副作用:
#     config MODULE_SCMVERSION
#         depends on LOCALVERSION_AUTO
# 关掉 AUTO 会让原机有的 CONFIG_MODULE_SCMVERSION 无法生效 ——
# 那又是一处与兼容性矩阵不一致。现在两项都按原机设置。
CONFIG_LOCALVERSION_AUTO=y
CONFIG_MODULE_SCMVERSION=y

# ---- 7) KPM (SukiSU 内核补丁模块) ----
# SukiSU-Ultra 的 kernel/Kconfig:
#   config KPM
#       bool "Enable SukiSU KPM"
#       depends on KSU && 64BIT
#       select KALLSYMS
#       select KALLSYMS_ALL
# 依赖已满足(KSU=y, arm64 即 64BIT)。注意作者在 help 里提示 KPM 可能影响稳定性。
CONFIG_KPM=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# ---- 8) 补回原机有、但展开后丢掉的项 (VINTF 兼容性矩阵会核对) ----
# 背景: Android 开机时 Build.isBuildConsistent() -> VintfObject.verifyWithoutAvb()
# 会读 /proc/config.gz, 核对 vendor 兼容性矩阵里 <kernel><config><key>CONFIG_xxx</key>
# 的要求。缺项就弹 "您的设备内部出现了问题。请联系您的设备制造商了解详情"。
#
# 用「从原机 boot.img 提取出的真实配置」逐项比对后, 原机 =y 而我们不是 y 的只剩:
#   CONFIG_MODULE_SCMVERSION   <- 这里补回 (Qualcomm 模块版本项, 矩阵里可能有)
#   CONFIG_DEBUG_INFO_DWARF4   <- 依赖 DEBUG_INFO, 纯构建期调试项, 不进 Image
#   CONFIG_WERROR              <- 构建期开关(关掉是为了不被 -Werror 中断编译)
#   CONFIG_LOCALVERSION_AUTO   <- 构建期开关(关掉才能固定内核版本串)
#   CONFIG_LTO_CLANG_FULL      <- 与 LTO_CLANG_THIN 互斥, thin 才和参考内核一致
#   CONFIG_TRIM_UNUSED_KSYMS   <- 构建期开关(需要小米编译机上的白名单文件)
#   CONFIG_DEBUG_INFO          <- 纯构建期, debug 段不进 Image
# 后 5 项是构建期开关或互斥项, 运行时内核里没有区别, 不可能是 VINTF 的 key;
# DEBUG_INFO_DWARF4 依赖 DEBUG_INFO, 为它打开 DEBUG_INFO 会显著拖慢 CI, 不值当。
# 所以只补 MODULE_SCMVERSION, 并让 configure.sh 的闸门硬断言它生效。
CONFIG_MODULE_SCMVERSION=y

