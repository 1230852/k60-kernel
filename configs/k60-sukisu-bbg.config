# ============================================================================
#  SukiSU Ultra + KPM + Baseband Guard (BBG)
#
#  SukiSU 采用 kprobe 钩子（GKI 官方推荐方式）。
#  基线 gki_defconfig 已有 CONFIG_KPROBES=y，因此【无需修改任何内核源码】。
#
#  【不可改动项】以下三项决定厂商预编译模块能否加载，改错会导致
#  原厂 Wi-Fi / 蓝牙 / 触控 / 音频等 vendor_dlkm 模块全部加载失败：
#     CONFIG_MODVERSIONS=y
#     CONFIG_MODULE_UNLOAD=y
#     CONFIG_PREEMPT=y
#  原因：kernel/module.c 的 same_magic() 在模块带 CRC 时忽略内核版本号，
#        只比较 "SMP preempt mod_unload modversions aarch64" 这一段。
# ============================================================================

# ----------------------------------------------------------------- SukiSU Ultra
CONFIG_KSU=y
CONFIG_KSU_MANUAL_SU=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set

# ------------------------------------------------------------- Baseband Guard
# 注意：CONFIG_BBG=y 时 CONFIG_LSM 里必须含 baseband_guard，
#       否则 BBG 的 Makefile 会主动 error 中断整个编译。
#       configure.sh 会自动把 baseband_guard 追加进 CONFIG_LSM。
CONFIG_BBG=y
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set
