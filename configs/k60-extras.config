# ============================================================================
#  Redmi K60 (mondrian) 驱动补齐 —— 网络增强
#  基线：小米官方 arch/arm64/configs/vendor/mondrian_GKI.config
#
#  【重要约束】厂商预编译模块 cfg80211.ko / mac80211.ko 位于 vendor_dlkm 分区
#  （见 modules.list.msm.mondrian），因此 CONFIG_CFG80211 / CONFIG_MAC80211
#  必须保持 =m。若改成内建(=y)，init 加载原厂 cfg80211.ko 时会符号冲突，
#  直接导致原厂 Wi-Fi 失效。所以下面所有 USB 无线网卡驱动一律 =m。
#
#  基线里已经具备（无需重复）：
#    WIREGUARD=y / TUN=y / L2TP=y / PPPOL2TP=y / IP_NF_IPTABLES=y
#    NETFILTER_XT_* 大部分 / NET_SCH_FQ=y / NET_SCH_FQ_CODEL=y / BINFMT_MISC=y
#    EXFAT_FS=y / F2FS_FS=y / OVERLAY_FS=y / VETH=y / BRIDGE=y
# ============================================================================

# ---------------------------------------------------------------- TCP 拥塞控制
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_VEGAS=y
CONFIG_TCP_CONG_WESTWOOD=y

# BBR 依赖 fq 队列规则
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_HTB=y

# ------------------------------------------------------------------ VPN / 隧道
CONFIG_TUN=y
CONFIG_WIREGUARD=y
CONFIG_L2TP=y
CONFIG_L2TP_V3=y
CONFIG_L2TP_IP=y
CONFIG_L2TP_ETH=y
CONFIG_NET_UDP_TUNNEL=y
CONFIG_PPP=y
CONFIG_PPPOL2TP=y

# --------------------------------------------------------- netfilter/ipset 扩展
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=65534
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_NETFILTER_XT_TARGET_TCPOPTSTRIP=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y

# ------------------------------------------------------ USB 无线网卡 (全部 =m)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_MEDIATEK=y

# Realtek RTL8188EU (staging 驱动，Kconfig 里写死 depends on m)
CONFIG_R8188EU=m
# Realtek RTL8188CU/8188RU/8191CU/8192CU/8723AU
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
# Ralink RT2070/RT2770/RT2870/RT3070/RT5370/RT5572
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
# Atheros AR9271
CONFIG_ATH9K_HTC=m
# MediaTek MT7601U
CONFIG_MT7601U=m
