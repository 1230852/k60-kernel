# SukiSU-Ultra + KernelPatchModule (KPM) defconfig fragment
# Target: Redmi K60 (mondrian, SM8475), Xiaomi_Kernel_OpenSource branch mondrian-s-oss (5.10 GKI)
#
# Applied on top of the mondrian "consolidate" chain:
#   gki_defconfig
#     + common/arch/arm64/configs/consolidate.fragment   (absent in this tarball, see note)
#     + arch/arm64/configs/vendor/mondrian_GKI.config
#     + arch/arm64/configs/vendor/mondrian_consolidate.config
#
# NOTE: in the plain MiCode tarball everything sits at the tree root, so
# `common/arch/arm64/configs/consolidate.fragment` does not exist. The build script must
# therefore merge gki_defconfig + the two vendor configs directly, then this fragment last.

# ---------------------------------------------------------------------------
# SukiSU-Ultra core
# ---------------------------------------------------------------------------
# Kconfig dependency chain (verified in drivers/kernelsu/Kconfig):
#   config KSU  -> depends on KPROBES && EXT4_FS
#   config KPM  -> depends on KSU && 64BIT, and selects KALLSYMS + KALLSYMS_ALL
# All of KPROBES, EXT4_FS, MODULES and KALLSYMS_ALL are already =y in gki_defconfig,
# so these two are the only additions actually needed.
CONFIG_KSU=y
CONFIG_KPM=y

# Hook selection. The GKI-default kprobe hook is the documented option for a bootable
# GKI-derived kernel; it requires CONFIG_KPROBES=y (present) and MANUAL_HOOK to be OFF.
# CONFIG_KSU_MANUAL_HOOK is not set
# CONFIG_KSU_TRACEPOINT_HOOK is not set

# Keep the manager APK integration and per-app policy profiles enabled (upstream defaults).
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set

# ---------------------------------------------------------------------------
# CFI / LTO — the critical compatibility decision
# ---------------------------------------------------------------------------
# gki_defconfig ships CONFIG_CFI_CLANG=y with CONFIG_LTO_CLANG_FULL=y.
# Clang CFI is a known conflict with KernelSU-style kprobe hooking: the kprobe
# trampoline calls through function pointers whose types do not match the CFI
# signature check, so hooks either fail to install or panic.
# Disable CFI and drop to thin LTO for the rooted build.
#
# Provide -DK60_CFI_MODE=off|thin|full to build.sh to change this behaviour.
# CONFIG_CFI_CLANG is not set
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set

# ---------------------------------------------------------------------------
# Extras that make root/verification workflows observable
# ---------------------------------------------------------------------------
# Needed by KPM's kallsyms-based symbol resolution and by userspace tooling.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KALLSYMS_BASE_RELATIVE=y

# Keep module unload/loading flexible for vendor_dlkm (BUILD_VENDOR_DLKM=1 in build.config).
CONFIG_MODULE_UNLOAD=y

# ---------------------------------------------------------------------------
# Assembler / LTO consistency (see scripts/build-kernel.sh)
# ---------------------------------------------------------------------------
# arch/arm64/include/asm/sysreg.h:50 picks the encoding of __emit_inst():
#   #ifndef CONFIG_BROKEN_GAS_INST   ->  .inst(x)      (integrated assembler)
#   #else                            ->  .long __INSTR_BSWAP(x)   (old GNU as workaround)
#
# CONFIG_BROKEN_GAS_INST is declared as
#   def_bool !$(as-instr,1:\n.inst 0\n.rept . - 1b\n\nnop\n.endr\n)
# It has NO prompt, so olddefconfig RECOMPUTES it and it CANNOT be pinned here. An earlier
# attempt to write `# CONFIG_BROKEN_GAS_INST is not set` in this fragment had no effect -
# confirmed by CI, which still reported CONFIG_BROKEN_GAS_INST=y.
#
# Therefore the consistency has to be arranged the other way round, by build-kernel.sh:
#   default   K60_LTO=none (LTO off) + LLVM_IAS=0
#             -> the probe's "broken GAS" verdict matches the actual GNU as, and the
#                .long encoding is correct
#   optional  K60_LTO=thin|full + K60_LLVM_IAS=1
#             -> requires the probe to report .inst support; if it does not, assembly of
#                arch/arm64/kvm/hyp/entry.S fails with "too many positional arguments"
#
# LTO is off by default because it is optional for this project (SukiSU, KPM and BBG do
# not require it) while being the sole source of this assembler conflict.

# ---------------------------------------------------------------------------
# Debug features that must be OFF for a usable kernel
# ---------------------------------------------------------------------------
# gki_defconfig is the GKI *debug* configuration and enables KASAN:
#   CONFIG_KASAN=y
#   CONFIG_KASAN_HW_TAGS=y
#
# Two independent reasons to disable it here:
#   1. KASAN is a debugging tool. It costs substantial CPU and memory (shadow memory,
#      per-access checks) and is not used by shipping device kernels.
#   2. It broke this build. KASAN instrumentation interacts badly with the arm64 entry
#      assembly, producing (observed in CI):
#         arch/arm64/kernel/entry.S:700: Error: attempt to move .org backwards
#         arch/arm64/kernel/entry.S:831: Error: bad or irreducible absolute expression
#      i.e. dozens of failures across the kernel_entry macro.
#
# Keep this off unless you are specifically debugging memory errors.
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_SW_TAGS is not set
# CONFIG_KASAN_INLINE is not set
# CONFIG_KASAN_OUTLINE is not set
# CONFIG_KASAN_STACK is not set
# CONFIG_KASAN_VMALLOC is not set
# CONFIG_KASAN_MODULE_TEST is not set
# CONFIG_KASAN_KUNIT_TEST is not set

# Match the scale shift that the (now disabled) KASAN would have defined, so nothing else
# in the build depends on it being explicitly set.

# ---------------------------------------------------------------------------
# Arm errata workarounds that emit `alternative_insn` sequences
# ---------------------------------------------------------------------------
# STATUS: this is a HYPOTHESIS being tested by CI, not a confirmed fix.
#
# The remaining build failure is 23x, all inside the kernel_entry macro:
#     arch/arm64/kernel/entry.S:700: Error: attempt to move .org backwards
#     arch/arm64/kernel/entry.S:831: Error: bad or irreducible absolute expression
#
# These arise from `alternative_insn` expansions. That macro pads with
#     .org . - (664b-663b) + (662b-661b)
# which assumes the two instruction slots are the SAME width; when they differ the
# directive "moves backwards" and GNU as rejects it. Candidate call sites are erratum
# workarounds whose alternatives have different encodings:
#     entry.S:481  alternative_insn nop, "dmb sy", ARM64_WORKAROUND_1508412
#     entry.S:959  alternative_insn isb, nop, ARM64_WORKAROUND_QCOM_FALKOR_E1003
#
# Some ARM64_* symbols are `def_bool y` options and CAN be pinned from a defconfig
# (unlike CONFIG_BROKEN_GAS_INST, which is recomputed). Whether pinning these actually
# removes the failing expansions is what the next CI run determines.
#
# IMPORTANT: disabling an erratum workaround is a genuine behavioural tradeoff on
# affected silicon. If this does unblock the build, the correct long-term fix is a
# toolchain/assembler that handles the macro - not shipping a kernel that silently drops
# errata mitigations. Treat this block as an experiment, not a solution.
# CONFIG_ARM64_ERRATUM_1508412 is not set
# CONFIG_ARM64_ERRATUM_1418040 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1003 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1009 is not set

# ---------------------------------------------------------------------------
# Baseband Guard (BBG) — kernel-level baseband partition protection
# ---------------------------------------------------------------------------
# vc-teahouse/Baseband-guard: an LSM that default-DENIES writes to block devices
# except an allowlist (boot/init_boot/vendor_boot/dtbo/userdata/cache/metadata/
# misc/vbmeta*/recovery). So modem, fsg, persist, abl, xbl, ... are protected by
# default — that is the "protect the baseband" requirement.
#
# A process is treated as "untrusted" when its SELinux domain is su / ksu / magisk,
# so this specifically blocks a ROOTED process from touching the baseband.
CONFIG_BBG=y

# !! MANDATORY. BBG's Makefile contains a hard gate:
#      if DEFINE_LSM exists and "baseband_guard" is not in CONFIG_LSM -> $(error ...)
# This kernel (5.10) HAS DEFINE_LSM, so the build ABORTS without this line.
#
# gki_defconfig does not set CONFIG_LSM at all, so the effective value otherwise
# comes from security/Kconfig's default:
#      "lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,bpf"
# We set it explicitly (as this tree's own generic_vm_defconfig does) and append
# baseband_guard. Doing it in the defconfig is deliberate: upstream's suggested sed
# on security/Kconfig is documented by upstream itself as corrupting the defaults.
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,baseband_guard,smack,tomoyo,apparmor,bpf"

# Optional extra hardening (both default n upstream). Left off because they block
# flashing kernels/recoveries from inside a booted Android system:
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set
